{
  "name": "phasedial-explorer",
  "private": true,
  "version": "1.0.0",
  "description": "An interactive learning simulator for quantum phase estimation, phase kickback, and finite precision.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Byt-wyze-technology/PhaseDial.git"
  },
  "homepage": "https://github.com/Byt-wyze-technology/PhaseDial#readme",
  "bugs": {
    "url": "https://github.com/Byt-wyze-technology/PhaseDial/issues"
  },
  "keywords": [
    "quantum-computing",
    "quantum-phase-estimation",
    "education",
    "simulation",
    "react"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "test:watch": "vitest",
    "audit:dependencies": "npm audit --audit-level=high",
    "check": "npm run audit:dependencies && npm test && npm run test:browser",
    "screenshots": "npm run build && node scripts/capture-readme-screenshots.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
